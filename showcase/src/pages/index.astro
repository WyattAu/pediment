---
import Layout from "../layouts/Layout.astro";
import { ThemeToggle } from "pediment-components";
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="relative overflow-hidden border-b border-[var(--border)] bg-[var(--bg-secondary)]">
    <div class="mx-auto max-w-[var(--max-width)] px-4 py-24 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-6xl">
        Pediment
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-[var(--text-secondary)]">
        A comprehensive design system for building modern web applications with
        Astro, SolidJS, and Cloudflare.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/components"
          class="rounded-[var(--radius-sm)] bg-[var(--accent)] px-6 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90"
        >
          Explore Components
        </a>
        <a
          href="https://github.com/WyattAu/pediment"
          class="rounded-[var(--radius-sm)] border border-[var(--border)] px-6 py-3 text-sm font-medium text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-card)]"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="mx-auto max-w-[var(--max-width)] px-4 py-16">
    <h2 class="mb-12 text-center text-3xl font-bold text-[var(--text-primary)]">
      What's Included
    </h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Design Tokens -->
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--accent)]/10 text-[var(--accent)]">
          <span class="text-xl">&#9881;</span>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-[var(--text-primary)]">Design Tokens</h3>
        <p class="text-sm text-[var(--text-secondary)]">
          Consistent colors, spacing, typography, and elevation through CSS custom properties.
        </p>
        <a href="/tokens" class="mt-4 inline-block text-sm font-medium text-[var(--accent)]">
          View Tokens &rarr;
        </a>
      </div>

      <!-- Components -->
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--accent)]/10 text-[var(--accent)]">
          <span class="text-xl">&#9632;</span>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-[var(--text-primary)]">Components</h3>
        <p class="text-sm text-[var(--text-secondary)]">
          12+ accessible, theme-aware UI components built with SolidJS.
        </p>
        <a href="/components" class="mt-4 inline-block text-sm font-medium text-[var(--accent)]">
          View Components &rarr;
        </a>
      </div>

      <!-- Themes -->
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--accent)]/10 text-[var(--accent)]">
          <span class="text-xl">&#9788;</span>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-[var(--text-primary)]">Themes</h3>
        <p class="text-sm text-[var(--text-secondary)]">
          5 built-in themes with easy customization through CSS custom properties.
        </p>
        <a href="/themes" class="mt-4 inline-block text-sm font-medium text-[var(--accent)]">
          View Themes &rarr;
        </a>
      </div>

      <!-- Hooks -->
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--accent)]/10 text-[var(--accent)]">
          <span class="text-xl">&#8635;</span>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-[var(--text-primary)]">Hooks</h3>
        <p class="text-sm text-[var(--text-secondary)]">
          Reusable SolidJS hooks for theme management, media queries, and local storage.
        </p>
        <a href="/components#hooks" class="mt-4 inline-block text-sm font-medium text-[var(--accent)]">
          View Hooks &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Quick Start -->
  <section class="border-t border-[var(--border)] bg-[var(--bg-secondary)]">
    <div class="mx-auto max-w-[var(--max-width)] px-4 py-16">
      <h2 class="mb-8 text-center text-3xl font-bold text-[var(--text-primary)]">
        Quick Start
      </h2>
      <div class="mx-auto max-w-lg">
        <pre><code># Install via CLI
bunx pediment init my-project
cd my-project
bun install
bun run dev

# Or add to existing project
bun add pediment-tokens pediment-components</code></pre>
      </div>
    </div>
  </section>

  <!-- Theme Preview -->
  <section class="mx-auto max-w-[var(--max-width)] px-4 py-16">
    <h2 class="mb-8 text-center text-3xl font-bold text-[var(--text-primary)]">
      Theme Preview
    </h2>
    <p class="mb-8 text-center text-[var(--text-secondary)]">
      Current theme: <code>midnight-navy</code>. Use the theme toggle in the navigation to switch themes.
    </p>
    <div class="flex justify-center">
      <ThemeToggle client:load />
    </div>
  </section>
</Layout>
