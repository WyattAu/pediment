---
import StoryLayout from '../../layouts/StoryLayout.astro';
import SkeletonDemo from '../../components/skeleton';
---

<StoryLayout title="Skeleton" description="Loading placeholder animations">
  <div class="mb-8">
    <a href="/" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)]">← Back</a>
    <h1 class="text-3xl font-bold mt-2 mb-2">Skeleton</h1>
    <p class="text-[var(--text-secondary)]">Loading placeholder animations for content.</p>
  </div>

  <div class="space-y-8">
    <section>
      <h2 class="text-lg font-semibold mb-3">Interactive Demo</h2>
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <SkeletonDemo client:only="solid-js" />
      </div>
    </section>

    <section>
      <h2 class="text-lg font-semibold mb-3">Source</h2>
      <pre><code>{`import Skeleton, { SkeletonText, SkeletonCard } from "@pediment-components/Skeleton";

<Skeleton width="200px" height="24px" />
<Skeleton width="100%" height="16px" rounded="full" />
<SkeletonText lines={4} />
<SkeletonCard />`}</code></pre>
    </section>
  </div>
</StoryLayout>
