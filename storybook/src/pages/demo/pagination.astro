---
import StoryLayout from '../../layouts/StoryLayout.astro';
import PaginationDemo from '../../components/pagination';
---

<StoryLayout title="Pagination" description="Page navigation controls">
  <div class="mb-8">
    <a href="/" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)]">← Back</a>
    <h1 class="text-3xl font-bold mt-2 mb-2">Pagination</h1>
    <p class="text-[var(--text-secondary)]">Page navigation with ellipsis and first/last buttons.</p>
  </div>

  <div class="space-y-8">
    <section>
      <h2 class="text-lg font-semibold mb-3">Interactive Demo</h2>
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <PaginationDemo client:only="solid-js" />
      </div>
    </section>

    <section>
      <h2 class="text-lg font-semibold mb-3">Source</h2>
      <pre><code>{`import Pagination from "@pediment-components/Pagination";

<Pagination
  page={currentPage}
  total={100}
  perPage={10}
  showFirstLast
  onPageChange={(p) => setPage(p)}
/>`}</code></pre>
    </section>
  </div>
</StoryLayout>
