---
import StoryLayout from '../../layouts/StoryLayout.astro';
import DatePickerDemo from '../../components/date-picker';
---

<StoryLayout title="Date Picker" description="Calendar date selection">
  <div class="mb-8">
    <a href="/" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)]">← Back</a>
    <h1 class="text-3xl font-bold mt-2 mb-2">Date Picker</h1>
    <p class="text-[var(--text-secondary)]">Calendar-based date selection component.</p>
  </div>

  <div class="space-y-8">
    <section>
      <h2 class="text-lg font-semibold mb-3">Interactive Demo</h2>
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <DatePickerDemo client:only="solid-js" />
      </div>
    </section>

    <section>
      <h2 class="text-lg font-semibold mb-3">Source</h2>
      <pre><code>{`import DatePicker from "@pediment-components/DatePicker";

<DatePicker placeholder="Pick a date" />
<DatePicker value={new Date()} onChange={(d) => console.log(d)} />`}</code></pre>
    </section>
  </div>
</StoryLayout>
