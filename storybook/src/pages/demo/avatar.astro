---
import StoryLayout from '../../layouts/StoryLayout.astro';
import AvatarDemo from '../../components/avatar';
---

<StoryLayout title="Avatar" description="User avatars with fallback initials">
  <div class="mb-8">
    <a href="/" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)]">← Back</a>
    <h1 class="text-3xl font-bold mt-2 mb-2">Avatar</h1>
    <p class="text-[var(--text-secondary)]">Display user avatars with automatic fallback to initials.</p>
  </div>

  <div class="space-y-8">
    <section>
      <h2 class="text-lg font-semibold mb-3">Interactive Demo</h2>
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <AvatarDemo client:only="solid-js" />
      </div>
    </section>

    <section>
      <h2 class="text-lg font-semibold mb-3">Props</h2>
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-[var(--bg-secondary)] border-b border-[var(--border)]">
              <th class="px-4 py-2 text-left font-medium">Prop</th>
              <th class="px-4 py-2 text-left font-medium">Type</th>
              <th class="px-4 py-2 text-left font-medium">Default</th>
              <th class="px-4 py-2 text-left font-medium">Description</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[var(--border)]">
              <td class="px-4 py-2"><code>src</code></td>
              <td class="px-4 py-2">string</td>
              <td class="px-4 py-2">—</td>
              <td class="px-4 py-2">Image URL</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <td class="px-4 py-2"><code>name</code></td>
              <td class="px-4 py-2">string</td>
              <td class="px-4 py-2">—</td>
              <td class="px-4 py-2">User name for initials fallback</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <td class="px-4 py-2"><code>size</code></td>
              <td class="px-4 py-2">sm | md | lg | xl</td>
              <td class="px-4 py-2">md</td>
              <td class="px-4 py-2">Avatar size</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="text-lg font-semibold mb-3">Source</h2>
      <pre><code>{`import Avatar from "@pediment/components/Avatar";

<Avatar name="Jane Doe" size="lg" />
<Avatar src="/photo.jpg" alt="User photo" />`}</code></pre>
    </section>
  </div>
</StoryLayout>
