---
import StoryLayout from '../../layouts/StoryLayout.astro';
import BadgeDemo from '../../components/badge';
---

<StoryLayout title="Badge" description="Status indicators and labels">
  <div class="mb-8">
    <a href="/" class="text-sm text-[var(--text-secondary)] hover:text-[var(--accent)]">← Back</a>
    <h1 class="text-3xl font-bold mt-2 mb-2">Badge</h1>
    <p class="text-[var(--text-secondary)]">Status indicators, labels, and tags with multiple variants.</p>
  </div>

  <div class="space-y-8">
    <section>
      <h2 class="text-lg font-semibold mb-3">Interactive Demo</h2>
      <div class="rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <BadgeDemo client:only="solid-js" />
      </div>
    </section>

    <section>
      <h2 class="text-lg font-semibold mb-3">Source</h2>
      <pre><code>{`import Badge from "@pediment/components/Badge";

<Badge variant="success" dot>Active</Badge>
<Badge variant="error" size="lg">Critical</Badge>
<Badge variant="outline">Draft</Badge>
<Badge removable onRemove={() => {}}>Dismiss</Badge>`}</code></pre>
    </section>
  </div>
</StoryLayout>
