{
  "name": "pediment",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*", "showcase", "storybook"],
  "description": "Shared design tokens, components, hooks, and utilities for Astro+SolidJS+Starlight+Cloudflare projects",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
